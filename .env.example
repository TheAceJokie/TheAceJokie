# Alpaca — השתמש במפתחות PAPER בלבד בשלב זה.
# קבל אותם ב: https://app.alpaca.markets  (Paper Trading -> API Keys)
ALPACA_API_KEY=your_paper_key_here
ALPACA_SECRET_KEY=your_paper_secret_here
# Paper endpoint. אל תשנה לאמיתי עד שמוכיחים רווחיות.
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Anthropic (Claude) — נדרש רק משלב 2 ואילך
ANTHROPIC_API_KEY=your_anthropic_key_here

# בטיחות: true = מצב יבש (לא שולח פקודות אמיתיות, רק מדפיס). מומלץ true עד שבטוח.
DRY_RUN=true
